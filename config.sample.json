{
  "data_dir": "",
  "keybindings": {
    "up": "k",
    "down": "j",
    "left": "h",
    "right": "l",
    "select": "enter",
    "quit": "q",
    "help": "?",
    "new": "n",
    "edit": "e",
    "delete": "d",
